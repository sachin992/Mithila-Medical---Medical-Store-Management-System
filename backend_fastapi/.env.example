DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/mithila_medical
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CANCELLATION_WINDOW_MINUTES=30
LOW_STOCK_THRESHOLD=20
CHAT_MEMORY_TTL_MINUTES=180
ALLOWED_ORIGINS=http://localhost:5173

# Optional notification providers
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# OpenAI LLM configuration
# Required
OPENAI_API_KEY="your-openai-api-key"

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Admin account generated from backend startup
ADMIN_EMAIL=admin@mithilamedical.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Admin
